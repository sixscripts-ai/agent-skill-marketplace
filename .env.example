# Copy to .env.local for local development. Never commit real secrets.

# Postgres (Prisma)
DATABASE_URL=postgres://user:pass@host/db

# Vercel Blob (package uploads)
BLOB_READ_WRITE_TOKEN=

# Clerk Authentication
# Development / Preview: use Clerk Development instance (pk_test_ / sk_test_).
# Vercel Production: use Clerk Production instance (pk_live_ / sk_live_).
# Mixing pk_test_ on Production causes accounts.dev handshake redirects and hurts PageSpeed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk URLs (defaults work with App Router catch-all pages)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public site URL (metadata, redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: real sandbox + providers
# ENABLE_REAL_SANDBOX=true
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
